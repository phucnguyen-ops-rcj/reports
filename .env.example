# Copy to .env and fill in values. Do NOT commit .env to git.
# Variables marked [ENV] must be set as OS environment variables, not in .env.

# Signal
SIGNAL_BASE_URL="http://127.0.0.1:8080"
SIGNAL_SENDER="+1234567890"
SIGNAL_RECIPIENT="+1234567890"   # individual recipient; leave blank to use SIGNAL_GROUP_ID
SIGNAL_GROUP_ID="group.xxx"      # get from GET /v1/groups/{number}

# CoinGecko
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"
# [ENV] export COINGECKO_API_KEY="CG-xxx"

# InfluxDB
INFLUXDB_BASE_URL="http://localhost:8086"
# [ENV] export INFLUXDB_TOKEN="xxx"
INFLUXDB_ORG="org_name"

# Kucoin
KUCOIN_SPOT_BASE = "https://api.kucoin.com"
KUCOIN_FUTURES_BASE = "https://api-futures.kucoin.com"

# Data source: "local" or "api"
SOURCE="local"

# File paths
NET_PNL_INPUT_PATH="data/trades.csv"
TRADING_VOLUME_INPUT_PATH="data/trading_volume.csv"
OUTPUT_DIR="results/daily"

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Timezone (IANA): https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ="Asia/Singapore"

ENABLE_SIGNAL_NOTIFICATIONS="true"
