# Copy to .env and fill in values. Do NOT commit .env to git.
# Variables marked [ENV] must be set as OS environment variables, not in .env.

# Signal
SIGNAL_BASE_URL="http://127.0.0.1:8081"
SIGNAL_SENDER="+1234567890"
SIGNAL_RECIPIENT="+1234567890"   # individual recipient; leave blank to use SIGNAL_GROUP_ID
SIGNAL_GROUP_ID="group.xxx"      # get from GET /v1/groups/{number}

# CoinGecko
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"
# [ENV] export COINGECKO_API_KEY="CG-xxx"

# InfluxDB
INFLUXDB_BASE_URL="http://localhost:8086"
# [ENV] export INFLUXDB_TOKEN="xxx"
INFLUXDB_ORG="org_name"

# Redis
REDISCLI_AUTH="xxx"

# Kucoin
KUCOIN_SPOT_BASE = "https://api.kucoin.com"
KUCOIN_FUTURES_BASE = "https://api-futures.kucoin.com"

# Data source: "local" or "api"
SOURCE="local"

# File paths
NET_PNL_INPUT_PATH="data/trades.csv"
TRADING_VOLUME_INPUT_PATH="data/trading_volume.csv"
OUTPUT_DIR="results/daily"

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Timezone (IANA): https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ="Asia/Singapore"

ENABLE_SIGNAL_NOTIFICATIONS="true"

# RCJ Trading API
RCJ_TRADING_TIMEOUT_SECONDS="30"

# Prefect runtime
PREFECT_API_URL="http://127.0.0.1:4200/api"
PREFECT_LOG_DIR="logs/prefect"
PREFECT_PID_DIR="logs/pid"
PREFECT_WORK_POOLS="default-agent-pool,ops-playbook-agent-pool,ops-agent-pool,volatility-agent-pool,volume-agent-pool,stacker-agent-pool,mirror-agent-pool"

# Prefect database
# Leave unset for Prefect's default SQLite database under PREFECT_HOME.
# For PostgreSQL, set the current Prefect 3 setting:
# PREFECT_API_DATABASE_CONNECTION_URL="postgresql+asyncpg://prefect:prefect@localhost:5432/prefect"

# RCJ ops API defaults
RCJ_OPS_BASE_ENDPOINT="http://18.176.93.228"
RCJ_OPS_TIMEOUT_SECONDS="60"
RCJ_OPS_EXECUTION_MODE="local"
RCJ_OPS_SSH_HOST="T1_newuser1"
RCJ_OPS_BEARER_TOKEN="xxx"
