# Copy this file to .env and fill in your values. Never commit .env to git.

# Signal — requires signal-cli REST API running locally (https://github.com/bbernhard/signal-cli-rest-api)
SIGNAL_BASE_URL="http://127.0.0.1:8080"
SIGNAL_SENDER="+1234567890"       # phone number registered with signal-cli
SIGNAL_RECIPIENT="+1234567890"    # individual recipient (used if no group)
SIGNAL_GROUP_ID="group.xxx"       # get from GET /v1/groups/{number}; leave blank to use SIGNAL_RECIPIENT

# CoinGecko — get a free API key at https://www.coingecko.com/api/documentation
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"
COINGECKO_API_KEY="CG-your_api_key_here"

# Paths — relative to project root or absolute
CSV_INPUT_PATH="data/trades.csv"  # daily trading data input file
OUTPUT_DIR="results/daily"        # where PNGs, CSVs, and report texts are saved

# Logging — DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Timezone — IANA identifier e.g. UTC, America/New_York (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ="Asia/Singapore"

# Features — set to false to skip sending without changing other settings
ENABLE_SIGNAL_NOTIFICATIONS="true"
