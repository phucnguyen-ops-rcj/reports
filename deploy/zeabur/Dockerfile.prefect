FROM python:3.14-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /uvx /bin/

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        openssh-client \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Copy only runtime inputs so local credentials, data, and logs never enter the image.
COPY pyproject.toml uv.lock README.md prefect.yaml ./
COPY src ./src
COPY deploy/zeabur/start-prefect.sh /usr/local/bin/start-prefect

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN uv sync --frozen --no-dev

RUN chmod 755 /usr/local/bin/start-prefect \
    && mkdir -p /app/data /app/logs /app/results

EXPOSE 4200

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/start-prefect"]
